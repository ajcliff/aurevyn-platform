index a56b22b..561ad3e 100644
--- a/src/lib/packages.ts
+++ b/src/lib/packages.ts
@@ -46,4 +46,31 @@ export async function createPackage(
   }
 
   return data as Package;
+}
+
+export async function updatePackage(
+  id: string,
+  updates: Partial<Pick<Package, "price" | "features" | "name">>
+) {
+  const supabase = createClient();
+  const { data, error } = await supabase
+    .from("packages")
+    .update(updates)
+    .eq("id", id)
+    .select()
+    .single();
+
+  if (error) {
+    console.error("Error updating package:", error);
+    return null;
+  }
+
+  return data as Package;
+}
+
+export async function deletePackage(id: string) {
+  const supabase = createClient();
+  const { error } = await supabase.from("packages").delete().eq("id", id);
+  if (error) console.error("Error deleting package:", error);
+  return !error;
 }
